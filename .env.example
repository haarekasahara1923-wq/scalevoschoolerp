# =============================================
# 🏫 SCLEVO SCHOOL ERP — Multi-Tenant Platform
# Developed by Scalevo
# =============================================

# =============================================
# 🗄️ DATABASE (Neon PostgreSQL) — REQUIRED
# Create a new DB at neon.tech for each deployment
# =============================================
DATABASE_URL="postgresql://username:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://username:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require"

# =============================================
# 🔐 AUTHENTICATION — REQUIRED
# Generate JWT secrets with: openssl rand -base64 64
# =============================================
JWT_SECRET="your-jwt-secret-minimum-32-characters-change-this"
JWT_REFRESH_SECRET="your-jwt-refresh-secret-minimum-32-characters-change-this"
DOOPER_JWT_SECRET="your-dooper-admin-jwt-secret-minimum-32-chars"
NEXTAUTH_URL="https://your-vercel-domain.vercel.app"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"

# =============================================
# 🌐 APP CONFIG
# =============================================
NEXT_PUBLIC_APP_NAME="Sclevo School ERP"
NEXT_PUBLIC_APP_URL="https://your-vercel-domain.vercel.app"

# =============================================
# 👑 DOOPER ADMIN SETUP — REQUIRED
# After deploying, run the seed script to create dooper admin:
# npx tsx prisma/seed.ts
# =============================================
# Dooper admin credentials are set in prisma/seed.ts

# =============================================
# 📧 EMAIL / SMTP
# =============================================
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-gmail-app-password"
EMAIL_FROM="Sclevo School ERP <your-email@gmail.com>"
RESEND_API_KEY="re_your_resend_api_key"

# =============================================
# 💬 WHATSAPP API (Meta Business) — Optional
# =============================================
WHATSAPP_API_TOKEN="your-whatsapp-api-token"
WHATSAPP_PHONE_NUMBER_ID="your-phone-number-id"
WHATSAPP_BUSINESS_ACCOUNT_ID="your-business-account-id"
WHATSAPP_VERIFY_TOKEN="sclevo-webhook-verify-token-2026"

# =============================================
# 🤖 AI SERVICES — Optional
# =============================================
OPENAI_API_KEY="sk-your-openai-api-key"
GEMINI_API_KEY="your-gemini-api-key"
GROQ_API_KEY="gsk_your-groq-api-key"

# =============================================
# 💳 RAZORPAY PAYMENT GATEWAY — REQUIRED
# Used for school subscription payments during signup
# Plans: Monthly ₹599 | Yearly ₹5000 | 3-Year ₹12000
# =============================================
RAZORPAY_KEY_ID="rzp_live_your-key-id"
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_live_your-key-id"
RAZORPAY_KEY_SECRET="your-razorpay-key-secret"
RAZORPAY_WEBHOOK_SECRET="your-webhook-secret"

# =============================================
# 📤 FILE STORAGE (Cloudinary) — REQUIRED
# Same credentials as before — no change needed
# =============================================
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-cloudinary-api-key"
CLOUDINARY_API_SECRET="your-cloudinary-api-secret"

# =============================================
# 🔴 REDIS (Upstash) — Optional for caching
# =============================================
UPSTASH_REDIS_REST_URL="https://your-redis.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-token"

# =============================================
# 📱 SMS API (Optional - MSG91)
# =============================================
MSG91_AUTH_KEY="your-msg91-auth-key"
MSG91_SENDER_ID="SCLEVO"
MSG91_TEMPLATE_ID="your-dlt-template-id"

# =============================================
# 🔔 WEB PUSH NOTIFICATIONS — Optional
# Generate VAPID keys: npx web-push generate-vapid-keys
# =============================================
NEXT_PUBLIC_VAPID_PUBLIC_KEY="your-vapid-public-key"
VAPID_PRIVATE_KEY="your-vapid-private-key"
